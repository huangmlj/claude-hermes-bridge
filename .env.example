# Claude-Hermes Bridge 环境配置示例
# 复制为 .env 后填入实际值

# ============ API 认证配置 ============
# API 认证密钥（可选）。设置后，除静态文件和健康检查外的所有 API 端点都需要认证
# 使用方式：在请求头中添加 Authorization: Bearer YOUR_API_KEY
# BRIDGE_API_KEY=your-secret-api-key-here

# ============ AI 模型名称配置 ============
# 显示在界面上的 AI 名称（可根据接入的模型修改）
AI_NAME_CLAUDE=Claude
AI_NAME_HERMES=MiniMax-M2.7

# Claude 模型 (Claude API 用)
CLAUDE_MODEL=claude-opus-4-6

# ============ AI 对话 Token 预算配置 ============
# 层级保留策略：
#   - LAYER_1_FULL: Layer 1 用户话题是否全量保留 (true/false)
#   - USER_MSG_FULL_COUNT: 用户发言保留最近几条 (默认1)
#   - LAYER_2to4_FULL: Layer 2-4 是否全量保留 (true/false)
#   - LAYER_5to10_TRUNCATE: Layer 5-10 截断比例 (0.0-1.0, 默认0.5截断50%)
#   - LAYER_OVER_10_SUMMARY: >Layer 10 是否只留摘要 (true/false)
#   - MAX_CHARS: 强制截断字符数上限 (默认10000)

LAYER_1_FULL=true
USER_MSG_FULL_COUNT=1
LAYER_2to4_FULL=true
LAYER_5to10_TRUNCATE=0.5
LAYER_OVER_10_SUMMARY=true
MAX_CHARS=10000

# ============ API 配置 ============
# Claude API Key (从 secrets_manager 获取，此处可作为降级方案)
# ANTHROPIC_API_KEY=

# ============ 服务配置 ============
# SSE 超时时间(秒)
SSE_TIMEOUT=300

# 轮询间隔(秒)
POLL_INTERVAL=2
