<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>⚡ Hermes × Claude 思想碰撞</title>
    <script>
        (function() {
            var theme = localStorage.getItem('theme');
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (theme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            /* Claude (Anthropic) Design System - Warm Parchment */
            --terracotta: #c96442;
            --terracotta-light: #d97757;
            --near-black: #141413;
            --dark-surface: #30302e;

            /* Text - Warm neutrals with yellow-brown undertone */
            --text-primary: #141413;
            --text-secondary: #5e5d59;
            --text-muted: #87867f;
            --text-inverse: #faf9f5;

            /* Background - Warm parchment tones */
            --bg-primary: #f5f4ed;
            --bg-secondary: #eeece5;
            --bg-surface: #e8e6dc;
            --bg-card: #faf9f5;
            --bg-sidebar: #3d3d3a;

            /* Borders - Cream tinted */
            --border-color: #f0eee6;
            --border-hover: #e8e6dc;
            --border-strong: #d4d1c4;

            /* Accents */
            --accent-green: #5a8a5a;
            --accent-red: #b53333;
            --accent-yellow: #c9a227;

            /* Shadows - Ring based, warm */
            --shadow-sm: rgba(0,0,0,0.04) 0px 1px 3px;
            --shadow-md: rgba(0,0,0,0.05) 0px 4px 12px;
            --shadow-lg: rgba(0,0,0,0.06) 0px 8px 24px;

            /* Border Radius */
            --radius-xs: 4px;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-pill: 9999px;

            /* Layout */
            --sidebar-width: 280px;
            --header-height: 64px;

            --theme-transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        [data-theme="dark"] {
            --text-primary: #f5f4ed;
            --text-secondary: #b0aea5;
            --text-muted: #6b6860;
            --text-inverse: #141413;
            --bg-primary: #141413;
            --bg-secondary: #1a1917;
            --bg-surface: #30302e;
            --bg-card: #1f1e1b;
            --bg-sidebar: #0d0d0c;
            --border-color: #30302e;
            --border-hover: #3d3d3a;
            --border-strong: #4a4843;
            --terracotta: #e07858;
            --terracotta-light: #c96442;
        }

        @media (prefers-color-scheme: light) {
            :root:not([data-theme="dark"]) {
                --text-primary: #141413;
                --text-secondary: #5e5d59;
                --text-muted: #87867f;
                --text-inverse: #faf9f5;
                --bg-primary: #f5f4ed;
                --bg-secondary: #eeece5;
                --bg-surface: #e8e6dc;
                --bg-card: #faf9f5;
                --bg-sidebar: #3d3d3a;
                --border-color: #f0eee6;
                --border-hover: #e8e6dc;
                --border-strong: #d4d1c4;
            }
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
            background: var(--bg-secondary);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
            display: flex;
        }

        /* ==================== SIDEBAR ==================== */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--bg-sidebar);
            color: var(--text-inverse);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            border-right: 1px solid var(--border-color);
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .sidebar-logo-icon {
            font-size: 28px;
        }

        .sidebar-logo-text {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: -0.5px;
        }

        .sidebar-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        /* Status Section */
        .sidebar-status {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .status-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .status-row:last-child {
            margin-bottom: 0;
        }

        .status-label {
            font-size: 13px;
            color: rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
        }

        .status-indicator.online {
            background: var(--accent-green);
            box-shadow: 0 0 6px var(--accent-green);
        }

        .status-indicator.error {
            background: var(--accent-red);
        }

        .status-value {
            font-size: 12px;
            font-weight: 500;
            color: rgba(255,255,255,0.8);
        }

        /* Navigation */
        .sidebar-nav {
            flex: 1;
            padding: 16px 12px;
            overflow-y: auto;
        }

        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            padding: 0 12px;
            margin-bottom: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .nav-item:hover {
            background: rgba(255,255,255,0.08);
            color: white;
        }

        .nav-item.active {
            background: var(--terracotta);
            color: white;
        }

        .nav-item-icon {
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .theme-toggle {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: var(--radius-md);
            color: rgba(255,255,255,0.7);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .theme-toggle:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .theme-dropdown {
            position: absolute;
            bottom: 100%;
            left: 0;
            right: 0;
            background: var(--bg-sidebar);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: var(--radius-md);
            padding: 8px;
            margin-bottom: 8px;
            display: none;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
            z-index: 1000;
        }

        .theme-dropdown.show {
            display: block;
        }

        .theme-dropdown-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.4);
            padding: 4px 12px 8px;
        }

        .theme-dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: var(--radius-sm);
            color: rgba(255,255,255,0.7);
            font-size: 14px;
            cursor: pointer;
            transition: var(--theme-transition);
            text-decoration: none;
        }

        .theme-dropdown-item:hover {
            background: rgba(255,255,255,0.08);
            color: white;
        }

        .theme-dropdown-item.active {
            background: var(--terracotta);
            color: white;
        }

        .theme-dropdown-item-icon {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .theme-dropdown-item-name {
            flex: 1;
        }

        .theme-dropdown-hint {
            font-size: 11px;
            color: rgba(255,255,255,0.3);
        }

        .sidebar-footer {
            position: relative;
        }

        /* ==================== MAIN CONTENT ==================== */
        .main {
            flex: 1;
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header */
        .header {
            height: var(--header-height);
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .header-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-btn {
            padding: 8px 16px;
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-pill);
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .header-btn:hover {
            background: var(--bg-card);
            border-color: var(--border-hover);
            color: var(--text-primary);
        }

        /* Chat Area */
        .chat-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            max-width: 900px;
            width: 100%;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Message Controls */
        .message-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            gap: 16px;
        }

        .filter-pills {
            display: flex;
            gap: 8px;
            background: var(--bg-surface);
            padding: 4px;
            border-radius: var(--radius-pill);
        }

        .filter-pill {
            padding: 8px 20px;
            background: transparent;
            border: none;
            border-radius: var(--radius-pill);
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .filter-pill:hover {
            color: var(--text-primary);
        }

        .filter-pill.active {
            background: var(--terracotta);
            color: white;
        }

        .search-box {
            position: relative;
            flex: 1;
            max-width: 300px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 16px 10px 40px;
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-pill);
            color: var(--text-primary);
            font-size: 14px;
            transition: var(--theme-transition);
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--terracotta);
            background: var(--bg-card);
        }

        .search-box input::placeholder {
            color: var(--text-muted);
        }

        .search-box-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
        }

        .message-count-badge {
            padding: 8px 16px;
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-pill);
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
        }

        /* Messages */
        .messages-wrapper {
            flex: 1;
            overflow-y: auto;
            padding: 8px 0;
        }

        .message {
            margin-bottom: 16px;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message-bubble {
            padding: 16px 20px;
            border-radius: var(--radius-lg);
            position: relative;
        }

        .message.claude .message-bubble {
            background: rgba(201,100,66,0.08);
            border: 1px solid rgba(201,100,66,0.2);
            margin-right: 60px;
        }

        .message.hermes .message-bubble {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            margin-left: 60px;
        }

        .message.system .message-bubble {
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
            margin: 0 80px;
        }

        .message-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .message-author {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        .message.claude .message-author {
            color: var(--terracotta);
        }

        .message.hermes .message-author {
            color: var(--text-secondary);
        }

        .message.system .message-author {
            color: var(--text-muted);
        }

        .message-layer {
            font-size: 11px;
            color: var(--text-muted);
            background: var(--bg-surface);
            padding: 2px 8px;
            border-radius: var(--radius-xs);
        }

        .message-time {
            font-size: 11px;
            color: var(--text-muted);
        }

        .message-content {
            font-size: 15px;
            line-height: 1.7;
            color: var(--text-primary);
        }

        .message-content p { margin-bottom: 12px; }
        .message-content p:last-child { margin-bottom: 0; }

        .message-content code {
            background: var(--bg-surface);
            padding: 2px 6px;
            border-radius: var(--radius-xs);
            font-family: "SF Mono", Monaco, monospace;
            font-size: 13px;
            color: var(--coinbase-blue);
        }

        .message-content pre {
            background: var(--near-black);
            color: #e0e0e0;
            padding: 16px;
            border-radius: var(--radius-md);
            overflow-x: auto;
            margin: 12px 0;
        }

        .message-content pre code {
            background: none;
            padding: 0;
            color: #e0e0e0;
        }

        .message-actions {
            position: absolute;
            top: 12px;
            right: 12px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .message:hover .message-actions {
            opacity: 1;
        }

        .action-btn {
            padding: 6px 10px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-xs);
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
            transition: var(--theme-transition);
        }

        .action-btn:hover {
            background: var(--bg-surface);
            color: var(--text-primary);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 24px;
            opacity: 0.6;
        }

        .empty-state-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .empty-state-desc {
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* AI Thinking */
        .ai-thinking {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 24px;
            margin-bottom: 16px;
        }

        .thinking-dots {
            display: flex;
            gap: 6px;
        }

        .thinking-dots span {
            width: 8px;
            height: 8px;
            background: var(--terracotta);
            border-radius: 50%;
            animation: thinking-bounce 1.4s infinite ease-in-out both;
        }

        .thinking-dots span:nth-child(1) { animation-delay: -0.32s; }
        .thinking-dots span:nth-child(2) { animation-delay: -0.16s; }

        @keyframes thinking-bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        .ai-thinking-text {
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* Input Area */
        .input-area {
            padding: 20px 0 32px;
            background: var(--bg-secondary);
        }

        .input-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 4px;
            transition: var(--theme-transition);
        }

        .input-container:focus-within {
            border-color: var(--terracotta);
            box-shadow: 0 0 0 3px rgba(201,100,66,0.15);
        }

        .input-row {
            display: flex;
            align-items: flex-end;
            gap: 12px;
        }

        #message-input {
            flex: 1;
            padding: 14px 16px;
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-size: 15px;
            font-family: inherit;
            resize: none;
            min-height: 48px;
            max-height: 200px;
        }

        #message-input:focus {
            outline: none;
        }

        #message-input::placeholder {
            color: var(--text-muted);
        }

        .input-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px;
        }

        .char-counter {
            font-size: 12px;
            color: var(--text-muted);
            padding: 0 8px;
        }

        .send-btn {
            padding: 10px 24px;
            background: var(--terracotta);
            border: none;
            border-radius: var(--radius-sm);
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .send-btn:hover {
            background: var(--terracotta-light);
        }

        .send-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* Control Buttons Row */
        .control-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 0;
            flex-wrap: wrap;
        }

        .control-btn {
            padding: 12px 24px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--theme-transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .control-btn:hover {
            background: var(--bg-surface);
            border-color: var(--border-hover);
        }

        .control-btn.primary {
            background: var(--terracotta);
            border-color: var(--terracotta);
            color: white;
        }

        .control-btn.primary:hover {
            background: var(--terracotta-light);
            border-color: var(--terracotta-light);
        }

        .control-btn.danger {
            background: rgba(234,74,74,0.1);
            border-color: rgba(234,74,74,0.3);
            color: var(--accent-red);
        }

        .control-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* History Panel */
        .history-panel {
            display: none;
        }

        .history-panel.active {
            display: block;
        }

        .history-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 16px;
        }

        .history-title {
            font-size: 18px;
            font-weight: 600;
        }

        .history-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            margin-bottom: 8px;
            cursor: pointer;
            transition: var(--theme-transition);
        }

        .history-item:hover {
            background: var(--bg-surface);
            border-color: var(--border-hover);
        }

        .history-info {
            flex: 1;
        }

        .history-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .history-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        .history-arrow {
            color: var(--text-muted);
            font-size: 18px;
        }

        /* Current Topic Banner */
        #current-topic {
            display: none;
            padding: 14px 18px;
            background: rgba(201,100,66,0.08);
            border: 1px solid rgba(201,100,66,0.2);
            border-radius: var(--radius-md);
            margin-bottom: 16px;
            font-size: 14px;
            color: var(--terracotta);
        }

        #current-topic.active {
            display: block;
        }

        /* Notification */
        .notification {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 1000;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .notification.show {
            transform: translateY(0);
            opacity: 1;
        }

        .notification-content {
            padding: 16px 24px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            font-size: 14px;
            font-weight: 500;
        }

        .notification.success .notification-content {
            background: rgba(0,166,91,0.15);
            border: 1px solid rgba(0,166,91,0.3);
            color: var(--accent-green);
        }

        .notification.error .notification-content {
            background: rgba(234,74,74,0.15);
            border: 1px solid rgba(234,74,74,0.3);
            color: var(--accent-red);
        }

        /* Loading */
        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid var(--border-color);
            border-top-color: var(--terracotta);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .message-loading {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 20px;
            color: var(--text-secondary);
        }

        /* Search match highlight */
        .message.search-match .message-bubble {
            background: rgba(201,100,66,0.1);
            border-color: rgba(201,100,66,0.3);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .main {
                margin-left: 0;
            }

            .header {
                padding: 0 16px;
            }

            .chat-container {
                padding: 0 16px;
            }

            .message-controls {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-pills {
                overflow-x: auto;
            }

            .search-box {
                max-width: none;
            }

            .message.claude .message-bubble,
            .message.hermes .message-bubble,
            .message.system .message-bubble {
                margin-left: 0;
                margin-right: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <span class="sidebar-logo-icon">⚡</span>
                <span class="sidebar-logo-text">Hermes × Claude</span>
            </div>
            <p class="sidebar-subtitle">AI 思想碰撞平台</p>
        </div>

        <div class="sidebar-status">
            <div class="status-row">
                <span class="status-label">
                    <span class="status-indicator" id="server-status"></span>
                    服务端
                </span>
                <span class="status-value" id="server-status-text">检测中</span>
            </div>
            <div class="status-row">
                <span class="status-label">
                    <span class="status-indicator" id="poll-status"></span>
                    轮询服务
                </span>
                <span class="status-value" id="poll-status-text">停止</span>
            </div>
            <div class="status-row">
                <span class="status-label">
                    <span class="status-indicator" id="sse-status-dot"></span>
                    实时同步
                </span>
                <span class="status-value" id="sse-status-text">连接中</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">当前会话</div>
                <div class="nav-item active" id="nav-chat">
                    <span class="nav-item-icon">💬</span>
                    <span>讨论区</span>
                </div>
                <div class="nav-item" id="nav-history">
                    <span class="nav-item-icon">📚</span>
                    <span>历史讨论</span>
                </div>
            </div>
        </nav>

        <div class="sidebar-footer">
            <button id="theme-toggle" style="
                width:36px;height:36px;display:flex;align-items:center;justify-content:center;
                background:transparent;border:none;border-radius:8px;cursor:pointer;font-size:18px;
            ">
                <span id="theme-icon">🌙</span>
            </button>
        </div>
        <script>
        (function() {
            var toggle = document.getElementById('theme-toggle');
            var icon = document.getElementById('theme-icon');
            var root = document.documentElement;

            function updateTheme() {
                var isDark = root.getAttribute('data-theme') === 'dark';
                icon.textContent = isDark ? '☀️' : '🌙';
            }

            toggle.addEventListener('click', function() {
                var isDark = root.getAttribute('data-theme') === 'dark';
                if (isDark) {
                    root.removeAttribute('data-theme');
                    localStorage.setItem('theme', 'light');
                } else {
                    root.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                }
                updateTheme();
            });

            updateTheme();
        })();
        </script>
    </aside>

    <!-- Main Content -->
    <main class="main">
        <header class="header">
            <h1 class="header-title" id="panel-title">开始讨论</h1>
            <div class="header-actions">
                <button class="header-btn" id="btn-export">📄 导出对话</button>
                <button class="header-btn" id="btn-claude-summary" disabled>📝 Claude 总结</button>
                <button class="header-btn" id="btn-hermes-summary" disabled>📝 Hermes 总结</button>
            </div>
        </header>

        <div class="chat-container">
            <!-- Chat View -->
            <div id="chat-view">
                <div id="current-topic"></div>

                <div class="control-row">
                    <button class="control-btn primary" id="btn-start">
                        <span>▶️</span> 开始讨论
                    </button>
                    <button class="control-btn danger" id="btn-end" disabled>
                        <span>⏹️</span> 结束讨论
                    </button>
                    <button class="control-btn primary" id="btn-start-ai" style="display:none;">
                        <span>🚀</span> 开始AI对话
                    </button>
                    <button class="control-btn danger" id="btn-pause-ai" style="display:none;">
                        <span>⏸️</span> 暂停AI对话
                    </button>
                </div>

                <div class="message-controls">
                    <div class="filter-pills">
                        <button class="filter-pill active" data-filter="all">全部</button>
                        <button class="filter-pill" data-filter="claude">🧠 Claude</button>
                        <button class="filter-pill" data-filter="hermes">💡 Hermes</button>
                        <button class="filter-pill" data-filter="system">✨ 用户</button>
                    </div>
                    <div class="search-box">
                        <span class="search-box-icon">🔍</span>
                        <input type="text" id="message-search" placeholder="搜索消息...">
                    </div>
                    <span class="message-count-badge" id="message-count">0 条消息</span>
                </div>

                <div class="messages-wrapper" id="message-area">
                    <div class="empty-state" id="empty-state">
                        <div class="empty-state-icon">💭</div>
                        <h2 class="empty-state-title">开始一场讨论</h2>
                        <p class="empty-state-desc">与 Claude 和 Hermes 展开思想碰撞</p>
                    </div>
                    <div id="ai-thinking" class="ai-thinking" style="display:none;">
                        <div class="thinking-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="ai-thinking-text">🤖 AI 正在思考...</span>
                    </div>
                </div>

                <div id="message-loading" class="message-loading" style="display:none;">
                    <div class="loading-spinner"></div>
                    <span>正在加载消息...</span>
                </div>

                <div class="input-area">
                    <div class="input-container">
                        <div class="input-row">
                            <textarea id="message-input" placeholder="输入你的问题... (Ctrl+Enter 发送)" maxlength="10000" rows="1"></textarea>
                            <div class="input-actions">
                                <span class="char-counter"><span id="char-count">0</span>/10000</span>
                                <button class="send-btn" id="btn-send">发送</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- History View -->
            <div id="history-view" class="history-panel">
                <div class="history-header">
                    <h2 class="history-title">📚 历史讨论</h2>
                    <button class="control-btn" id="btn-close-history">← 返回</button>
                </div>
                <div id="history-list" class="history-list"></div>
            </div>
        </div>
    </main>

    <!-- Notification -->
    <div class="notification" id="notification">
        <div class="notification-content" id="notification-content"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">
    <script>
        const API_BASE = '';
        let status = {};
        let lastMessageCount = 0;
        let isLoading = false;
        let currentTheme = localStorage.getItem('theme') || 'auto';
        let isViewingHistory = false;

        // SSE
        let sseConnection = null;
        let lastEventId = localStorage.getItem('lastEventId') || '0';

        function initSSE() {
            if (sseConnection) sseConnection.close();
            const url = API_BASE + '/api/events' + (lastEventId !== '0' ? `?lastEventId=${lastEventId}` : '');
            sseConnection = new EventSource(url);

            sseConnection.onopen = () => {
                reconnectAttempts = 0;
                updateSSEStatus('connected');
            };

            sseConnection.onmessage = (event) => {
                try {
                    const msg = JSON.parse(event.data);
                    appendMessage(msg);
                    lastEventId = event.lastEventId || (parseInt(lastEventId) + 1).toString();
                    localStorage.setItem('lastEventId', lastEventId);
                } catch (e) {
                    console.error('SSE parse error:', e);
                }
            };

            sseConnection.onerror = () => {
                updateSSEStatus('disconnected');
                sseConnection.close();
                scheduleReconnect();
            };
        }

        let reconnectAttempts = 0;
        const MAX_RECONNECT_DELAY = 30000;
        const BASE_RECONNECT_DELAY = 1000;

        function scheduleReconnect() {
            if (reconnectAttempts >= 10) return;
            const delay = Math.min(BASE_RECONNECT_DELAY * Math.pow(2, reconnectAttempts), MAX_RECONNECT_DELAY);
            reconnectAttempts++;
            updateSSEStatus('reconnecting', delay);
            setTimeout(initSSE, delay);
        }

        function updateSSEStatus(status, countdown = 0) {
            const dot = document.getElementById('sse-status-dot');
            const text = document.getElementById('sse-status-text');
            if (!dot) return;

            dot.className = 'status-indicator';
            if (status === 'connected') {
                dot.classList.add('online');
                text.textContent = '已连接';
            } else if (status === 'reconnecting') {
                text.textContent = `重连中 (${Math.ceil(countdown/1000)}s)`;
            } else {
                dot.classList.add('error');
                text.textContent = '断开';
            }
        }

        // Theme
        function initTheme() {
            const toggle = document.getElementById('theme-toggle');
            const dropdown = document.getElementById('theme-dropdown');

            // 获取当前页面文件名作为 active 状态
            const currentPage = window.location.pathname.split('/').pop() || 'index.html';
            dropdown.querySelectorAll('.theme-dropdown-item').forEach(item => {
                item.classList.toggle('active', item.getAttribute('href') === currentPage);
            });

            toggle.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdown.classList.toggle('show');
            });

            // 点击其他地方关闭
            document.addEventListener('click', () => {
                dropdown.classList.remove('show');
            });

            // 阻止dropdown内部点击冒泡
            dropdown.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        // API
        async function api(endpoint, options = {}) {
            try {
                const res = await fetch(API_BASE + endpoint, options);
                if (!res.ok) throw new Error(res.statusText);
                return await res.json();
            } catch (e) {
                console.error('API error:', e);
                return null;
            }
        }

        // Messages
        function appendMessage(msg) {
            const area = document.getElementById('message-area');
            const emptyState = document.getElementById('empty-state');
            if (emptyState) emptyState.remove();
            hideAIThinking();

            const div = document.createElement('div');
            div.className = `message ${msg.author}`;
            div.dataset.content = msg.content || '';
            div.dataset.layer = msg.layer;

            const authorLabel = msg.author === 'claude' ? '🧠 Claude' : msg.author === 'hermes' ? '💡 Hermes' : '✨ 用户';
            const timestamp = msg.timestamp ? new Date(msg.timestamp).toLocaleTimeString() : '';
            const renderedContent = safeMarkedParse(msg.content || '');

            div.innerHTML = `
                <div class="message-bubble">
                    <div class="message-header">
                        <span class="message-author">${authorLabel}</span>
                        <span class="message-layer">Layer ${msg.layer}</span>
                        <span class="message-time">${timestamp}</span>
                    </div>
                    <div class="message-content">${renderedContent}</div>
                    <div class="message-actions">
                        <button class="action-btn" onclick="copyMessage('${escapeJS(msg.content || '')}')">📋</button>
                    </div>
                </div>
            `;

            area.appendChild(div);
            updateMessageCount();
            area.scrollTop = area.scrollHeight;
        }

        function escapeJS(str) {
            return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n');
        }

        function safeMarkedParse(content) {
            if (!content) return '';
            try {
                return DOMPurify.sanitize(marked.parse(content));
            } catch (e) {
                return '<p>⚠️ 渲染失败</p>';
            }
        }

        function copyMessage(content) {
            navigator.clipboard.writeText(content).then(() => {
                showNotification('已复制到剪贴板', 'success');
            });
        }

        function updateMessageCount() {
            const count = document.querySelectorAll('.message').length;
            document.getElementById('message-count').textContent = `${count} 条消息`;
        }

        function showAIThinking() {
            document.getElementById('ai-thinking').style.display = 'flex';
        }

        function hideAIThinking() {
            document.getElementById('ai-thinking').style.display = 'none';
        }

        // Search
        function initSearch() {
            const input = document.getElementById('message-search');
            input.addEventListener('input', () => {
                const query = input.value.toLowerCase().trim();
                document.querySelectorAll('.message').forEach(msg => {
                    const content = (msg.dataset.content || '').toLowerCase();
                    const author = msg.querySelector('.message-author').textContent.toLowerCase();
                    if (!query || content.includes(query) || author.includes(query)) {
                        msg.style.display = '';
                        msg.classList.toggle('search-match', !!query);
                    } else {
                        msg.style.display = 'none';
                        msg.classList.remove('search-match');
                    }
                });
            });
        }

        // Filters
        function initFilters() {
            document.querySelectorAll('.filter-pill').forEach(pill => {
                pill.addEventListener('click', () => {
                    document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
                    pill.classList.add('active');
                    const filter = pill.dataset.filter;
                    document.querySelectorAll('.message').forEach(msg => {
                        if (filter === 'all' || msg.classList.contains(filter)) {
                            msg.style.display = '';
                        } else {
                            msg.style.display = 'none';
                        }
                    });
                });
            });
        }

        // History
        function showHistory() {
            isViewingHistory = true;
            document.getElementById('chat-view').style.display = 'none';
            document.getElementById('history-view').classList.add('active');
            document.getElementById('nav-chat').classList.remove('active');
            document.getElementById('nav-history').classList.add('active');
            loadHistoryList();
        }

        function hideHistory() {
            isViewingHistory = false;
            document.getElementById('chat-view').style.display = '';
            document.getElementById('history-view').classList.remove('active');
            document.getElementById('nav-chat').classList.add('active');
            document.getElementById('nav-history').classList.remove('active');
        }

        async function loadHistoryList() {
            const list = document.getElementById('history-list');
            list.innerHTML = '<div class="message-loading"><div class="loading-spinner"></div><span>加载中...</span></div>';

            const data = await api('/discussions');
            if (!data || !data.discussions) {
                list.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:40px;">暂无历史讨论</p>';
                return;
            }

            if (data.discussions.length === 0) {
                list.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:40px;">暂无历史讨论</p>';
                return;
            }

            list.innerHTML = data.discussions.map(d => `
                <div class="history-item" onclick="loadDiscussion('${d.filename}')">
                    <div class="history-info">
                        <div class="history-name">${d.filename}</div>
                        <div class="history-meta">${d.preview || '无预览'}</div>
                    </div>
                    <span class="history-arrow">→</span>
                </div>
            `).join('');
        }

        async function loadDiscussion(filename) {
            hideHistory();
            showLoading(true);
            const data = await api(`/discussions/${filename}`);
            showLoading(false);
            if (data && data.messages) {
                data.messages.forEach(msg => appendMessage(msg));
            }
        }

        // Notification
        function showNotification(message, type = 'success') {
            const notif = document.getElementById('notification');
            const content = document.getElementById('notification-content');
            content.textContent = message;
            notif.className = `notification ${type} show`;
            setTimeout(() => notif.classList.remove('show'), 3000);
        }

        // Loading
        function showLoading(show = true) {
            document.getElementById('message-loading').style.display = show ? 'flex' : 'none';
        }

        // Controls
        async function startDiscussion() {
            const input = document.getElementById('message-input');
            const content = input.value.trim();
            if (!content) return;

            const btn = document.getElementById('btn-start');
            btn.innerHTML = '<div class="loading-spinner" style="width:16px;height:16px;border-width:2px;"></div> 启动中...';
            btn.disabled = true;

            const result = await api('/api/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content })
            });

            btn.innerHTML = '<span>▶️</span> 开始讨论';
            btn.disabled = false;

            if (result && result.success) {
                input.value = '';
                document.getElementById('btn-end').disabled = false;
                document.getElementById('current-topic').textContent = '讨论主题: ' + content;
                document.getElementById('current-topic').classList.add('active');
                document.getElementById('panel-title').textContent = '讨论中';
            }
        }

        async function endDiscussion() {
            const btn = document.getElementById('btn-end');
            btn.innerHTML = '<div class="loading-spinner" style="width:16px;height:16px;border-width:2px;"></div> 结束中...';
            btn.disabled = true;

            const result = await api('/api/end', { method: 'POST' });

            if (result && result.success) {
                document.getElementById('btn-end').disabled = true;
                document.getElementById('btn-start-ai').style.display = 'none';
                document.getElementById('btn-pause-ai').style.display = 'none';
                document.getElementById('current-topic').classList.remove('active');
                document.getElementById('panel-title').textContent = '已结束';
            } else {
                btn.innerHTML = '<span>⏹️</span> 结束讨论';
                btn.disabled = false;
            }
        }

        // Status check
        async function checkStatus() {
            const data = await api('/api/status');
            if (data) {
                const serverDot = document.getElementById('server-status');
                const serverText = document.getElementById('server-status-text');
                serverDot.className = 'status-indicator online';
                serverText.textContent = '在线';

                const pollDot = document.getElementById('poll-status');
                const pollText = document.getElementById('poll-status-text');
                if (data.poll_running) {
                    pollDot.className = 'status-indicator online';
                    pollText.textContent = '运行中';
                } else {
                    pollDot.className = 'status-indicator';
                    pollText.textContent = '停止';
                }
            } else {
                document.getElementById('server-status').className = 'status-indicator error';
                document.getElementById('server-status-text').textContent = '离线';
            }
        }

        // Char counter
        function updateCharCount() {
            const input = document.getElementById('message-input');
            const counter = document.getElementById('char-count');
            counter.textContent = input.value.length;
        }

        // Auto-resize textarea
        function autoResize() {
            const input = document.getElementById('message-input');
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 200) + 'px';
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            initSSE();
            initSearch();
            initFilters();
            checkStatus();
            setInterval(checkStatus, 10000);

            // Navigation
            document.getElementById('nav-history').addEventListener('click', showHistory);
            document.getElementById('nav-chat').addEventListener('click', hideHistory);
            document.getElementById('btn-close-history').addEventListener('click', hideHistory);

            // Buttons
            document.getElementById('btn-start').addEventListener('click', startDiscussion);
            document.getElementById('btn-end').addEventListener('click', endDiscussion);
            document.getElementById('btn-send').addEventListener('click', () => {
                const input = document.getElementById('message-input');
                if (input.value.trim()) {
                    startDiscussion();
                }
            });

            // Input
            const input = document.getElementById('message-input');
            input.addEventListener('input', () => {
                updateCharCount();
                autoResize();
            });
            input.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'Enter') {
                    startDiscussion();
                }
            });

            // Export
            document.getElementById('btn-export').addEventListener('click', async () => {
                const messages = document.querySelectorAll('.message');
                let content = '# Hermes × Claude 对话导出\n\n';
                messages.forEach(msg => {
                    const author = msg.querySelector('.message-author').textContent;
                    const layer = msg.querySelector('.message-layer').textContent;
                    const text = msg.dataset.content || '';
                    content += `## ${author} (${layer})\n\n${text}\n\n---\n\n`;
                });

                const blob = new Blob([content], { type: 'text/markdown' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `discussion_${Date.now()}.md`;
                a.click();
                URL.revokeObjectURL(url);
                showNotification('对话已导出', 'success');
            });

            updateCharCount();
        });
    </script>
</body>
</html>
